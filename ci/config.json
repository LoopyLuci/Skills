{
  "skills_dir": "skills",
  "source_dir": "_sources",
  "adapted_manifest": "scripts/customization-manifest.json",
  "min_python": "3.10",
  "jobs": 8,
  "history_limit": 50,
  "log_limit": 50,
  "max_file_mb": 5,
  "max_skill_dir_mb": 20,
  "max_findings_per_stage": 600,
  "make_archive": true,
  "archive_exclude": [
    ".git",
    "_sources",
    "ci/reports",
    "ci/logs",
    "dist",
    "__pycache__"
  ],
  "required_frontmatter": [
    "name",
    "description",
    "version",
    "author",
    "license",
    "platforms",
    "metadata"
  ],
  "allowed_licenses": [
    "MIT",
    "UPL-1.0",
    "Apache-2.0",
    "BSD-3-Clause",
    "ISC",
    "MPL-2.0",
    "Unlicense",
    "CC0-1.0"
  ],
  "require_tags": true,
  "require_source_for_adapted": true,
  "forbid_self_tag": true,
  "overlap_max_lines": 20,
  "overlap_max_similarity": 0.75,
  "secret_patterns": [
    "-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----",
    "AKIA[0-9A-Z]{16}",
    "ghp_[A-Za-z0-9]{36}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "xox[baprs]-[A-Za-z0-9-]{10,}",
    "sk-[A-Za-z0-9]{20,}",
    "AIza[0-9A-Za-z_-]{35}",
    "eyJ[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{20,}\\.[A-Za-z0-9_-]{10,}"
  ],
  "ruff_select": "E9,F63,F7,F82,B006,B008",
  "test_timeout": 900,
  "command_timeout": 600,
  "deploy_remote": "origin",
  "deploy_branch": "main",
  "secret_assignment_patterns": [
    "(?i)(password|passwd|secret|api[_-]?key|token)\\s*[=:]\\s*['\\\"][^'\\\"]{12,}['\\\"]"
  ],
  "secret_code_extensions": [
    ".py",
    ".js",
    ".ts",
    ".mjs",
    ".cjs",
    ".sh",
    ".bash",
    ".ps1",
    ".env",
    ".yml",
    ".yaml",
    ".json",
    ".toml",
    ".ini",
    ".cfg",
    ".rb",
    ".go",
    ".rs",
    ".java"
  ],
  "secret_ignore_markers": [
    "your-",
    "xxx",
    "example",
    "changeme",
    "placeholder",
    "redact",
    "<",
    ">",
    "${",
    "...",
    "dummy",
    "sample",
    "test-",
    "fake"
  ]
}